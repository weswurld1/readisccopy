# Durable storage for Relay. Copy this file to `.env.local` and fill in values.
#   cp .env.local.example .env.local
#
# The app reads EITHER naming convention below — you only need ONE pair.
# Leave everything blank to run in in-memory mode (no persistence).

# --- Option A: Upstash Redis (console.upstash.com -> your DB -> REST API) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Option B: Vercel KV (auto-injected by the Vercel Upstash integration) ---
# When you connect Upstash from Vercel's Storage tab, these are set for you in
# the deployment. Only set them here if you want durable storage locally too.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
