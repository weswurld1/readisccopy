{
  "name": "relay-desktop",
  "version": "0.1.0",
  "description": "Relay desktop app (Electron) for Windows",
  "main": "main.js",
  "author": "weswurld1",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.relay.desktop",
    "productName": "Relay",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": ["main.js", "package.json"],
    "win": {
      "target": ["zip"]
    },
    "//nsis-note": "The 'nsis' installer target needs Windows Developer Mode ON (Settings > Privacy & security > For developers) so electron-builder can extract its winCodeSign helper, which contains symlinks. With that enabled, add 'nsis' to win.target. 'zip' needs no special privilege.",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
